# Скопируйте в secrets.properties (файл вне git) и заполните.
# Пустые значения допустимы: сборка пройдёт, в BuildConfig попадут пустые строки.

# appId агента из панели OrionStar (https://jiedai.ainirobot.com/...).
# Попадает в сгенерированный assets/actionRegistry.json и BuildConfig.AGENT_APP_ID.
AGENT_APP_ID=

# Токен робота для backend (Authorization: Bearer ...), см. docs/api-contract.md
ROBOT_TOKEN=

# Базовый URL backend с /v1, например https://robot-api.example.kz/v1
# Локально с эмулятора: http://10.0.2.2:8000/v1 . Пусто -> на эмуляторе заглушка FakeBackendApi.
BACKEND_URL=

# Другие хосты, на которые можно переключить сервер с экрана диагностики (через запятую, без схемы),
# например robot-api.example.kz,robot-api-staging.example.kz . Хост из BACKEND_URL разрешён всегда.
# В release — только https и только эти хосты; в debug дополнительно http на приватные IP
# (10.x, 172.16–31.x, 192.168.x, эмулятор 10.0.2.2).
BACKEND_ALLOWED_HOSTS=

# PIN выхода и экрана диагностики: латинские буквы и цифры, 4–12 знаков (например a1b2c3d4), лучше 8+.
# В APK попадает только хеш. Пусто: на роботе (robot/robotos) диагностика недоступна, на эмуляторе — без PIN.
DIAG_PIN=
# Необязательная соль для хеша PIN (по умолчанию — фиксированная строка проекта).
DIAG_PIN_SALT=

# Голос (builtin | server), меняется и на роботе без пересборки — экран диагностики.
# Распознавание (все языки), по умолчанию server.
VOICE_ASR=
# Синтез по языкам: по умолчанию server (голос ElevenLabs через /v1/tts) на всех языках.
VOICE_TTS_RU=
VOICE_TTS_KK=
VOICE_TTS_EN=
# Сбой /v1/tts (после 1 повтора): true — говорить встроенным голосом робота; false (по умолчанию) — текст на экране
# без звука и фраза «не могу сейчас говорить» из кеша ElevenLabs. false также запрещает откат на встроенный ASR без связи.
VOICE_BUILTIN_FALLBACK=
# Конец фразы посетителя после N мс тишины (VAD приложения, 300–1500), по умолчанию 500. Меняется в диагностике.
VAD_END_SILENCE_MS=
# Потоковый /v1/tts?stream=true (звук с первых байт), по умолчанию true. Меняется в диагностике.
TTS_STREAMING=
# Заставка и сброс сессии после N секунд бездействия, по умолчанию 60; 0 — выключено.
SCREENSAVER_SECONDS=
# Разговор: agent — агентский чат POST /v1/chat (по умолчанию), legacy — локальные правила + /v1/ask,
# live — живой голосовой режим WS /v1/live (как голосовой режим ChatGPT; сбой → agent, повтор через 30 с).
# Меняется и без пересборки — экран диагностики.
CHAT_MODE=
