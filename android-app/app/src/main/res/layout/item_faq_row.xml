<?xml version="1.0" encoding="utf-8"?>
<!-- Строка частых вопросов: вопрос + стрелка (заголовок фиксированной высоты — все строки одинаковые); раскрытая — короткий ответ, «Проводить», «Показать полностью». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_row"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="4dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/hub_shadow_soft"
    android:outlineSpotShadowColor="@color/hub_shadow_soft">

    <LinearLayout
        android:id="@+id/rowHeader"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_min_height"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="32dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/rowQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.0"
            android:maxLines="2"
            android:textColor="@color/hub_ink"
            android:textSize="@dimen/text_faq_row"
            tools:text="Как подключиться к Wi-Fi?" />

        <ImageView
            android:id="@+id/rowChevron"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hub_expand"
            android:tint="@color/hub_muted2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/rowAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:textColor="@color/hub_ink"
            android:textSize="@dimen/text_faq_answer"
            tools:text="Сеть «AstanaHub_Guest». Пароль на стойке ресепшена у входа." />

        <LinearLayout
            android:id="@+id/rowActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowGuide"
                style="@style/Hub.Chip"
                android:layout_marginEnd="20dp"
                android:drawableStart="@drawable/ic_hub_nav"
                android:visibility="gone"
                tools:text="Проводить"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/rowMore"
                style="@style/Hub.LinkBtn"
                android:visibility="gone"
                tools:text="Показать полностью"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
