<?xml version="1.0" encoding="utf-8"?>
<!-- Киоск 1920×1080, альбом. Слева — аватар, статус и язык; справа — субтитры, частые вопросы, ввод. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hub_background"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/screen_padding">

    <!-- Левая колонка -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/brandText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/hub_primary"
            android:textSize="@dimen/text_brand"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:contentDescription="@null"
            android:src="@drawable/avatar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="@color/hub_on_background"
                android:textSize="@dimen/text_status"
                tools:text="Слушаю…" />
        </LinearLayout>

        <TextView
            android:id="@+id/offlineBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/offline_badge"
            android:textColor="@color/hub_offline"
            android:textSize="@dimen/text_label"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/micOffBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/mic_off_badge"
            android:textColor="@color/hub_offline"
            android:textSize="@dimen/text_label"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/langGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/langRu"
                style="@style/Widget.Hub.LangButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RU"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/langKk"
                style="@style/Widget.Hub.LangButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KZ"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/langEn"
                style="@style/Widget.Hub.LangButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN"
                tools:ignore="HardcodedText" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/buildText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/hub_muted"
            android:textSize="14sp"
            tools:text="emulator · debug · v0.1.0" />
    </LinearLayout>

    <!-- Правая колонка -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="@color/hub_muted"
            android:textSize="@dimen/text_question"
            tools:text="«Где проходит регистрация на хакатон?»" />

        <ScrollView
            android:id="@+id/answerScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:fillViewport="true"
            android:padding="32dp">

            <TextView
                android:id="@+id/answerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/hub_on_background"
                android:textSize="@dimen/text_answer"
                tools:text="Регистрация открыта на 2 этаже, у стойки ресепшена. Возьмите с собой удостоверение." />
        </ScrollView>

        <Button
            android:id="@+id/guideButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:textSize="@dimen/text_button"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_directions"
            app:iconSize="32dp"
            tools:text="Проводить: Кафе"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/quickTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/hub_muted"
            android:textSize="@dimen/text_label"
            tools:text="Частые вопросы" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/quickContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLength="500"
                    android:textSize="@dimen/text_button" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/sendButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="16dp"
                android:textSize="@dimen/text_button"
                tools:text="Спросить" />

            <Button
                android:id="@+id/micButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="16dp"
                android:textSize="@dimen/text_button"
                tools:text="Микрофон" />

            <Button
                android:id="@+id/lookButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="16dp"
                android:textSize="@dimen/text_button"
                tools:text="Что это?" />

            <Button
                android:id="@+id/stopButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="16dp"
                android:textSize="@dimen/text_button"
                tools:text="Стоп" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Заставка после бездействия (шаг 7.4): касание или голос — назад к главному экрану. -->
    <LinearLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hub_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="64dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:contentDescription="@null"
            android:src="@drawable/avatar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/screensaver_title"
            android:textColor="@color/hub_on_primary"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/screensaver_hint"
            android:textColor="@color/hub_on_primary"
            android:textSize="26sp" />
    </LinearLayout>
</FrameLayout>
