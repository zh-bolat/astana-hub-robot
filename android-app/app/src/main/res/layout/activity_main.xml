<?xml version="1.0" encoding="utf-8"?>
<!--
  Главный экран-киоск, вариант А (прототип: docs/design/robot-mvp.html).
  Сетка 1600 dp по ширине (UiScale), размеры совпадают с прототипом:
  верхняя полоса 88 dp (Назад · бренд · RU/KZ/EN · выход), слева 560 dp — лицо робота, статус, субтитры,
  справа — приветствие с плитками / ответ / частые вопросы, нижняя полоса 120 dp — три места под кнопки.
  Объём: свет сверху слева — градиенты и светлые кромки в drawable, тени — elevation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipChildren="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- Верхняя полоса -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:background="@drawable/bg_top_bar"
            android:clipChildren="false"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/backButton"
                style="@style/Hub.TopBtn"
                android:layout_marginEnd="20dp"
                android:drawableStart="@drawable/ic_hub_back"
                android:visibility="gone"
                tools:text="Назад"
                tools:visibility="visible" />

            <!-- Логотип Astana Hub (удержание 3 с — диагностика) -->
            <ImageView
                android:id="@+id/brandLogo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/brand_logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/title"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/astana_hub_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/langGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/langRu"
                    style="@style/Hub.LangBtn"
                    android:layout_marginStart="0dp"
                    android:text="RU"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/langKk"
                    style="@style/Hub.LangBtn"
                    android:text="KZ"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/langEn"
                    style="@style/Hub.LangBtn"
                    android:text="EN"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <View
                android:layout_width="2dp"
                android:layout_height="44dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@color/hub_line" />

            <!-- Из меню обратно к лицу робота (только режим agent) -->
            <TextView
                android:id="@+id/faceButton"
                style="@style/Hub.TopBtn"
                android:layout_marginEnd="20dp"
                android:drawableStart="@drawable/ic_sparkle"
                android:visibility="gone"
                tools:text="К роботу"
                tools:visibility="visible" />

            <!-- Выход из приложения: сначала подтверждение (exitOverlay) -->
            <ImageButton
                android:id="@+id/exitButton"
                android:layout_width="@dimen/top_btn_height"
                android:layout_height="@dimen/top_btn_height"
                android:background="@drawable/bg_round_btn"
                android:elevation="2dp"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_hub_close"
                android:stateListAnimator="@animator/press_sink"
                android:tint="@color/hub_muted2"
                tools:contentDescription="Выйти из приложения" />
        </LinearLayout>

        <!-- Нет связи с сервером -->
        <LinearLayout
            android:id="@+id/offlineBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_offline"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hub_info"
                android:tint="@color/hub_amber_fg" />

            <TextView
                android:id="@+id/offlineText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/hub_amber_fg"
                android:textSize="26sp"
                tools:text="Нет связи с сервером" />
        </LinearLayout>

        <!-- Основная часть: слева робот, справа разговор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/leftColumn"
                android:layout_width="@dimen/left_column_width"
                android:layout_height="match_parent"
                android:clipChildren="false">

                <!-- Подсветка за лицом: светлое пятно на фоне -->
                <View
                    android:layout_width="720dp"
                    android:layout_height="720dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_spot" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp">

                    <kz.astanahub.robot.ui.RobotFaceView
                        android:id="@+id/face"
                        android:layout_width="400dp"
                        android:layout_height="400dp"
                        android:layout_marginTop="-40dp"
                        android:layout_marginBottom="-40dp" />

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/hub_muted2"
                        android:textSize="30sp"
                        tools:text="Готов помочь" />

                    <!-- Что робот слышит (пока посетитель говорит) -->
                    <TextView
                        android:id="@+id/heardText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:ellipsize="start"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:maxWidth="460dp"
                        android:maxLines="3"
                        android:minHeight="72dp"
                        android:textColor="@color/hub_muted2"
                        android:textSize="26sp"
                        tools:text="«Где здесь можно выпить кофе»" />

                    <!-- Субтитры: облачко под лицом, хвостик указывает на лицо -->
                    <FrameLayout
                        android:id="@+id/subtitleBox"
                        android:layout_width="480dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipChildren="false"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/subtitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:accessibilityLiveRegion="polite"
                            android:background="@drawable/bg_bubble"
                            android:elevation="@dimen/elev_card"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.15"
                            android:minHeight="132dp"
                            android:outlineSpotShadowColor="@color/hub_shadow_blue"
                            android:paddingStart="30dp"
                            android:paddingTop="24dp"
                            android:paddingEnd="30dp"
                            android:paddingBottom="24dp"
                            android:textColor="@color/hub_ink"
                            android:textSize="@dimen/text_subtitle"
                            tools:text="Astana Hub — международный технопарк IT-стартапов" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="18dp"
                            android:layout_gravity="top|center_horizontal"
                            android:contentDescription="@null"
                            android:elevation="@dimen/elev_card"
                            android:outlineProvider="none"
                            android:src="@drawable/bg_bubble_tail" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/micOffBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/hub_offline"
                        android:textSize="22sp"
                        android:visibility="gone"
                        tools:text="Микрофон выключен: нет разрешения"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/buildText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.6"
                    android:textColor="@color/hub_muted"
                    android:textSize="14sp"
                    tools:text="emulator · debug · v0.1.0" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="48dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <!-- Приветствие и плитки -->
                    <LinearLayout
                        android:id="@+id/homePanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/greetTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/hub_ink"
                            android:textSize="@dimen/text_greet"
                            tools:text="Здравствуйте! Чем помочь?" />

                        <TextView
                            android:id="@+id/greetSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="36dp"
                            android:textColor="@color/hub_muted2"
                            android:textSize="@dimen/text_greet_sub"
                            tools:text="Спросите голосом или выберите тему" />

                        <LinearLayout
                            android:id="@+id/tilesRow1"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/tile_height"
                            android:clipChildren="false"
                            android:orientation="horizontal" />

                        <LinearLayout
                            android:id="@+id/tilesRow2"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/tile_height"
                            android:layout_marginTop="24dp"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- Ответ -->
                    <LinearLayout
                        android:id="@+id/answerPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/questionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="@color/hub_muted2"
                            android:textSize="28sp"
                            tools:text="«Где здесь можно выпить кофе?»" />

                        <LinearLayout
                            android:id="@+id/answerCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:elevation="@dimen/elev_card"
                            android:orientation="vertical"
                            android:outlineAmbientShadowColor="@color/hub_shadow_soft"
                            android:outlineSpotShadowColor="@color/hub_shadow_soft"
                            android:paddingStart="36dp"
                            android:paddingTop="32dp"
                            android:paddingEnd="36dp"
                            android:paddingBottom="32dp">

                            <ScrollView
                                android:id="@+id/answerScroll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fadeScrollbars="false"
                                android:scrollbarSize="6dp">

                                <TextView
                                    android:id="@+id/answerText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:lineSpacingMultiplier="1.1"
                                    android:maxLines="3"
                                    android:textColor="@color/hub_ink"
                                    android:textSize="@dimen/text_answer"
                                    tools:text="Кафе на первом этаже: от меня прямо и направо, около 25 метров." />
                            </ScrollView>

                            <TextView
                                android:id="@+id/showMoreButton"
                                style="@style/Hub.LinkBtn"
                                android:layout_marginTop="20dp"
                                android:visibility="gone"
                                tools:text="Показать полностью"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Частые вопросы: аккордеон, по 3 на странице -->
                    <LinearLayout
                        android:id="@+id/faqPanel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/faqTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:fontFamily="@font/nunito_extrabold"
                            android:textColor="@color/hub_ink"
                            android:textSize="@dimen/text_faq_title"
                            tools:text="Частые вопросы" />

                        <ScrollView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:paddingBottom="12dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/faqList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:orientation="vertical" />
                        </ScrollView>
                    </LinearLayout>
                </FrameLayout>

                <!-- Ввод текстом: только эмулятор (на роботе — голос) -->
                <LinearLayout
                    android:id="@+id/inputRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayout"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSend"
                            android:inputType="text"
                            android:maxLength="500"
                            android:textSize="22sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/sendButton"
                        style="@style/Hub.LinkBtn"
                        android:layout_marginStart="16dp"
                        tools:text="Спросить" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Нижняя полоса: слева «В начало», в центре одно главное действие, справа «Что это?» -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/homeButton"
                    style="@style/Hub.Btn"
                    android:layout_gravity="start|center_vertical"
                    android:drawableStart="@drawable/ic_hub_home"
                    tools:text="В начало" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/hintButton"
                    style="@style/Hub.Btn"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hint"
                    android:drawableStart="@drawable/ic_hub_mic"
                    android:drawableTint="@color/hub_primary"
                    android:elevation="0dp"
                    android:fontFamily="@font/nunito"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:textColor="@color/hub_muted2"
                    android:textSize="28sp"
                    tools:text="Просто скажите вопрос, я слушаю" />

                <TextView
                    android:id="@+id/stopButton"
                    style="@style/Hub.Btn.Primary.Stop"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_hub_stop"
                    android:visibility="gone"
                    tools:text="Стоп" />

                <TextView
                    android:id="@+id/guideButton"
                    style="@style/Hub.Btn.Primary"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_hub_nav"
                    android:visibility="gone"
                    tools:text="Проводить: Кафе" />

                <TextView
                    android:id="@+id/faqMoreButton"
                    style="@style/Hub.Btn"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_hub_expand"
                    android:visibility="gone"
                    tools:text="Ещё вопросы (1/3)" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipChildren="false">

                <TextView
                    android:id="@+id/lookButton"
                    style="@style/Hub.Btn"
                    android:layout_gravity="end|center_vertical"
                    android:drawableStart="@drawable/ic_hub_camera"
                    tools:text="Что это?" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      Лицо-тамагочи на весь экран (режим agent): разговор лицом к лицу.
      Сверху — логотип, «слушаю / думаю / говорю», языки; в центре — лицо; снизу — что слышу, крупные субтитры,
      кнопки частых вопросов (запасной ввод), «Меню» (или жест вверх) и «Стоп».
    -->
    <LinearLayout
        android:id="@+id/faceLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen"
        android:clickable="true"
        android:clipChildren="false"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/top_bar_height"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <ImageView
                android:id="@+id/faceLogo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/brand_logo_height"
                android:adjustViewBounds="true"
                android:contentDescription="@string/title"
                android:scaleType="fitCenter"
                android:src="@drawable/astana_hub_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/faceStatus"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_height"
                android:background="@drawable/bg_chip"
                android:drawablePadding="12dp"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:textColor="@color/hub_on_tint"
                android:textSize="32sp"
                tools:text="Слушаю…" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/faceLangRu"
                style="@style/Hub.LangBtn"
                android:text="RU"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/faceLangKk"
                style="@style/Hub.LangBtn"
                android:text="KZ"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/faceLangEn"
                style="@style/Hub.LangBtn"
                android:text="EN"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">

            <View
                android:layout_width="820dp"
                android:layout_height="820dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_spot" />

            <kz.astanahub.robot.ui.RobotFaceView
                android:id="@+id/bigFace"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Офлайн: мелко, чтобы не пугать посетителя -->
            <TextView
                android:id="@+id/faceOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/bg_offline"
                android:paddingStart="24dp"
                android:paddingTop="8dp"
                android:paddingEnd="24dp"
                android:paddingBottom="8dp"
                android:textColor="@color/hub_offline"
                android:textSize="24sp"
                android:visibility="gone"
                tools:text="Нет связи с сервером"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Что робот слышит, пока посетитель говорит -->
        <TextView
            android:id="@+id/faceHeard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:gravity="center"
            android:maxLines="2"
            android:paddingStart="80dp"
            android:paddingEnd="80dp"
            android:textColor="@color/hub_muted2"
            android:textSize="34sp"
            tools:text="«Где здесь можно выпить кофе»" />

        <!-- Крупные субтитры: фраза, которую робот говорит сейчас -->
        <TextView
            android:id="@+id/faceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="64dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="64dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_bubble"
            android:elevation="@dimen/elev_card"
            android:gravity="center"
            android:lineSpacingMultiplier="1.12"
            android:maxLines="3"
            android:ellipsize="end"
            android:outlineSpotShadowColor="@color/hub_shadow_blue"
            android:paddingStart="40dp"
            android:paddingTop="24dp"
            android:paddingEnd="40dp"
            android:paddingBottom="24dp"
            android:textColor="@color/hub_ink"
            android:textSize="44sp"
            android:visibility="gone"
            tools:text="Коворкинг на втором этаже, справа от лифта."
            tools:visibility="visible" />

        <!-- Ввод текстом: только эмулятор -->
        <LinearLayout
            android:id="@+id/faceInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="160dp"
            android:paddingEnd="160dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/faceInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/faceInputText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLength="500"
                    android:textSize="22sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/faceSendButton"
                style="@style/Hub.LinkBtn"
                android:layout_marginStart="16dp"
                tools:text="Спросить" />
        </LinearLayout>

        <!-- Низ: микрофон · частые вопросы (или «Стоп») · меню -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">

            <TextView
                android:id="@+id/faceMicButton"
                style="@style/Hub.Btn"
                android:background="@drawable/bg_hint"
                android:contentDescription="@string/action_mic"
                android:drawableStart="@drawable/ic_hub_mic"
                android:drawablePadding="0dp"
                android:drawableTint="@color/hub_primary"
                android:paddingStart="28dp"
                android:paddingEnd="28dp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/faceChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:clipChildren="false"
                    android:gravity="center"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/faceStopButton"
                    style="@style/Hub.Btn.Primary.Stop"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_hub_stop"
                    android:visibility="gone"
                    tools:text="Стоп" />
            </FrameLayout>

            <TextView
                android:id="@+id/faceMenuButton"
                style="@style/Hub.Btn"
                android:drawableStart="@drawable/ic_hub_expand"
                tools:text="Меню" />
        </LinearLayout>
    </LinearLayout>

    <!-- «Веду вас»: на весь экран, пока робот едет -->
    <LinearLayout
        android:id="@+id/guideOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay"
        android:clickable="true"
        android:clipChildren="false"
        android:elevation="16dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/guideArrow"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_hub_nav"
            android:tint="@color/hub_primary" />

        <TextView
            android:id="@+id/guideTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:textColor="@color/hub_ink"
            android:textSize="@dimen/text_overlay_big"
            tools:text="Иду к: Кафе" />

        <TextView
            android:id="@+id/guideSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/hub_muted2"
            android:textSize="@dimen/text_overlay_small"
            tools:text="Следуйте за мной" />

        <TextView
            android:id="@+id/guideStopButton"
            style="@style/Hub.Btn.Primary.Stop"
            android:layout_marginTop="56dp"
            android:drawableStart="@drawable/ic_hub_stop"
            tools:text="Стоп" />
    </LinearLayout>

    <!-- Сон (SLEEP): никого нет — «спящее» лицо; подошёл человек, касание или голос — просыпается -->
    <LinearLayout
        android:id="@+id/screensaver"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay"
        android:clickable="true"
        android:elevation="18dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="64dp"
        android:visibility="gone">

        <kz.astanahub.robot.ui.RobotFaceView
            android:id="@+id/saverFace"
            android:layout_width="480dp"
            android:layout_height="480dp"
            android:layout_marginTop="-60dp"
            android:layout_marginBottom="-40dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_extrabold"
            android:gravity="center"
            android:text="@string/screensaver_title"
            android:textColor="@color/hub_ink"
            android:textSize="60sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/screensaver_hint"
            android:textColor="@color/hub_muted2"
            android:textSize="26sp" />
    </LinearLayout>

    <!-- Подтверждение выхода: чтобы посетитель не закрыл приложение случайно -->
    <FrameLayout
        android:id="@+id/exitOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hub_scrim"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/exitCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_exit_card"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="24dp"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingTop="56dp"
            android:paddingEnd="64dp"
            android:paddingBottom="56dp">

            <TextView
                android:id="@+id/exitQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_extrabold"
                android:textColor="@color/hub_ink"
                android:textSize="52sp"
                tools:text="Выйти из приложения?" />

            <TextView
                android:id="@+id/exitSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="@color/hub_muted2"
                android:textSize="30sp"
                tools:text="Робот перестанет отвечать посетителям." />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:clipChildren="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exitNoButton"
                    style="@style/Hub.Btn.Primary"
                    tools:text="Остаться" />

                <TextView
                    android:id="@+id/exitYesButton"
                    style="@style/Hub.Btn"
                    android:layout_marginStart="24dp"
                    tools:text="Выйти" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
