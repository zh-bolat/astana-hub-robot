<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка на приветствии: иконка в голубом скруглённом квадрате слева, подпись справа (до 2 строк).
     Все плитки одного размера; выбранная (isSelected) подсвечена. Тень — elevation, нажатие — «проседает». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_tile"
    android:clickable="true"
    android:elevation="@dimen/elev_card"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/hub_shadow_soft"
    android:outlineSpotShadowColor="@color/hub_shadow_soft"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"
    android:stateListAnimator="@animator/press_sink">

    <ImageView
        android:id="@+id/tileIcon"
        android:layout_width="@dimen/tile_icon_box"
        android:layout_height="@dimen/tile_icon_box"
        android:background="@drawable/bg_tile_icon"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:padding="12dp"
        tools:src="@drawable/ic_tile_help" />

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/nunito_semibold"
        android:lineSpacingMultiplier="1.0"
        android:maxLines="2"
        android:textColor="@color/hub_ink"
        android:textSize="@dimen/text_tile"
        tools:text="Частые вопросы" />
</LinearLayout>
