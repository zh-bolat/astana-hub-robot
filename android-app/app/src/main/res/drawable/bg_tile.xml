<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка: почти белая с бледной рамкой; выбранная (нажатая посетителем) — голубая с синеватой рамкой. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F1F5FF" android:endColor="#DFE8FF" />
            <stroke android:width="1dp" android:color="@color/hub_box_line_selected" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F4F7FD" android:endColor="#FFFFFF" />
            <stroke android:width="1dp" android:color="@color/hub_box_line" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#FBFDFF" />
            <stroke android:width="1dp" android:color="@color/hub_box_line" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
