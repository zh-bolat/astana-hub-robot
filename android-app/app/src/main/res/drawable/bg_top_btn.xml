<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#EEF2F8" />
                    <stroke android:width="2dp" android:color="#DDE3EE" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:left="20dp" android:right="20dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#E4E9F2" android:endColor="#EEF2F8" />
                    <stroke android:width="2dp" android:color="#DDE3EE" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:left="20dp" android:right="20dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#E4E9F2" android:endColor="#EEF2F8" />
                    <stroke android:width="2dp" android:color="#DDE3EE" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:left="20dp" android:right="20dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#EEF2F8" />
                    <stroke android:width="2dp" android:color="#DDE3EE" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:left="20dp" android:right="20dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
