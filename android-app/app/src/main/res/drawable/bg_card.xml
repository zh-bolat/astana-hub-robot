<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#FAFBFE" />
                    <stroke android:width="2dp" android:color="#E1E6F0" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:left="16dp" android:right="16dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FAFBFE" android:endColor="#FFFFFF" />
                    <stroke android:width="2dp" android:color="#E1E6F0" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:left="16dp" android:right="16dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FAFBFE" android:endColor="#FFFFFF" />
                    <stroke android:width="2dp" android:color="#E1E6F0" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:left="16dp" android:right="16dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#FAFBFE" />
                    <stroke android:width="2dp" android:color="#E1E6F0" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:left="16dp" android:right="16dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
