<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#E4E9F2" android:endColor="#EEF2F8" />
            <stroke android:width="2dp" android:color="#DDE3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#EEF2F8" />
            <stroke android:width="2dp" android:color="#DDE3EE" />
        </shape>
    </item>
</selector>
