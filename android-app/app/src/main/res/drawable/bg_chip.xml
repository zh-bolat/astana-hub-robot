<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#F2F6FF" android:endColor="#DCE6FF" />
                    <stroke android:width="2dp" android:color="#00000000" />
                    <corners android:radius="36dp" />
                </shape>
            </item>
            <item android:left="22dp" android:right="22dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#CCFFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#D0DCFF" android:endColor="#E4ECFF" />
                    <stroke android:width="2dp" android:color="#00000000" />
                    <corners android:radius="36dp" />
                </shape>
            </item>
            <item android:left="22dp" android:right="22dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#CCFFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#D0DCFF" android:endColor="#E4ECFF" />
                    <stroke android:width="2dp" android:color="#00000000" />
                    <corners android:radius="36dp" />
                </shape>
            </item>
            <item android:left="22dp" android:right="22dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#CCFFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#F2F6FF" android:endColor="#DCE6FF" />
                    <stroke android:width="2dp" android:color="#00000000" />
                    <corners android:radius="36dp" />
                </shape>
            </item>
            <item android:left="22dp" android:right="22dp" android:top="2dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#CCFFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
