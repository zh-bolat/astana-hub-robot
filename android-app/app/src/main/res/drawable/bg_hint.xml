<?xml version="1.0" encoding="utf-8"?>
<!-- «Просто скажите вопрос»: не кнопка-действие, а подсказка — пунктир, утоплена в фон -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B3FFFFFF" />
            <stroke android:width="2dp" android:color="#C9D2E2" android:dashWidth="10dp" android:dashGap="8dp" />
            <corners android:radius="48dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#8CFFFFFF" />
            <stroke android:width="2dp" android:color="#D3DAE6" android:dashWidth="10dp" android:dashGap="8dp" />
            <corners android:radius="48dp" />
        </shape>
    </item>
</selector>
