<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#F2F6FF" />
                    <stroke android:width="3dp" android:color="#1F4FFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#F2F6FF" android:endColor="#FFFFFF" />
                    <stroke android:width="3dp" android:color="#1F4FFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#F2F6FF" android:endColor="#FFFFFF" />
                    <stroke android:width="3dp" android:color="#1F4FFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#F2F6FF" />
                    <stroke android:width="3dp" android:color="#1F4FFF" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="3dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#E6FFFFFF" />
                    <size android:height="2dp" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
