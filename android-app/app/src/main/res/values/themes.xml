<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AstanaHubRobot" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/hub_primary</item>
        <item name="colorOnPrimary">@color/hub_on_primary</item>
        <item name="android:colorBackground">@color/hub_background</item>
        <item name="colorOnBackground">@color/hub_on_background</item>
        <item name="colorSurface">@color/hub_surface</item>
        <item name="android:windowBackground">@color/hub_background</item>
        <!-- Шрифт всего приложения: Nunito (вшит в APK) -->
        <item name="android:fontFamily">@font/nunito</item>
        <item name="fontFamily">@font/nunito</item>
    </style>

    <!-- Главный экран-киоск (экраны 1 и 2 — Compose, чёрные): окно до первого кадра тоже чёрное — без белой вспышки
         при запуске и скачка яркости. -->
    <style name="Theme.AstanaHubRobot.Kiosk" parent="Theme.AstanaHubRobot">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
    </style>

    <!-- Кнопки главного экрана — TextView с фоном: полный контроль над градиентом, тенью и «проседанием» -->
    <style name="Hub.Btn" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/btn_height</item>
        <item name="android:minWidth">@dimen/btn_height</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:textColor">@color/hub_ink</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/hub_ink</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:elevation">@dimen/elev_btn</item>
        <item name="android:outlineSpotShadowColor">@color/hub_shadow_ink</item>
        <item name="android:stateListAnimator">@animator/press_sink</item>
    </style>

    <style name="Hub.Btn.Primary">
        <item name="android:layout_height">@dimen/btn_primary_height</item>
        <item name="android:paddingStart">56dp</item>
        <item name="android:paddingEnd">56dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/hub_on_primary</item>
        <item name="android:textSize">@dimen/text_btn_primary</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
        <item name="android:drawableTint">@color/hub_on_primary</item>
        <item name="android:elevation">@dimen/elev_primary</item>
        <item name="android:outlineSpotShadowColor">@color/hub_shadow_blue</item>
        <item name="android:outlineAmbientShadowColor">@color/hub_shadow_blue</item>
        <item name="android:shadowColor">#59081658</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Hub.Btn.Primary.Stop">
        <item name="android:background">@drawable/bg_btn_stop</item>
        <item name="android:outlineSpotShadowColor">@color/hub_shadow_ink</item>
        <item name="android:outlineAmbientShadowColor">@color/hub_shadow_ink</item>
    </style>

    <style name="Hub.TopBtn" parent="Hub.Btn">
        <item name="android:layout_height">@dimen/top_btn_height</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:background">@drawable/bg_top_btn</item>
        <item name="android:textSize">@dimen/text_top</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/hub_primary</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Hub.LangBtn" parent="Hub.TopBtn">
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:background">@drawable/bg_lang</item>
        <item name="android:textColor">@color/lang_text</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>

    <style name="Hub.Chip" parent="Hub.Btn">
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/hub_on_tint</item>
        <item name="android:textSize">28sp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/hub_on_tint</item>
        <item name="android:elevation">2dp</item>
        <item name="android:outlineSpotShadowColor">@color/hub_shadow_blue</item>
    </style>

    <style name="Hub.LinkBtn" parent="Hub.Btn">
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.Hub.LangButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">96dp</item>
    </style>

    <style name="Widget.Hub.DiagLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/hub_muted</item>
    </style>

    <style name="Widget.Hub.DiagButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
