  "components": {
    "schemas": {
      "AnswerResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "phrases": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Phrases"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ru",
              "kk",
              "en"
            ],
            "title": "Lang"
          },
          "found": {
            "type": "boolean",
            "title": "Found"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "answer",
          "phrases",
          "lang",
          "found",
          "sources"
        ],
        "title": "AnswerResponse"
      },
      "AskRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "lang": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ru",
                  "kk",
                  "en"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Lang"
          },
          "session_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Session Id"
          },
          "place_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          }
        },
        "type": "object",
        "required": [
          "question",
          "session_id"
        ],
        "title": "AskRequest",
        "example": {
          "lang": "ru",
          "place_id": "reception",
          "question": "Где проходит регистрация на хакатон?",
          "session_id": "6f1c2a9e-7d4b-4c1a-9f3e-2b8d5e6a7c10"
        }
      },
      "ChatMessage": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ask",
              "look",
              "where_is",
              "guide_to",
              "where_am_i"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ru",
              "kk",
              "en"
            ],
            "title": "Lang"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "found": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Found"
          },
          "interrupted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interrupted"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "kind",
          "text",
          "lang",
          "created_at",
          "request_id"
        ],
        "title": "ChatMessage"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "HealthResponse"
      },
      "LocalMessageRequest": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "where_is",
              "guide_to",
              "where_am_i"
            ],
            "title": "Kind"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Answer"
          },
          "lang": {
            "type": "string",
            "enum": [
              "ru",
              "kk",
              "en"
            ],
            "title": "Lang"
          },
          "place_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Place Id"
          },
          "found": {
            "type": "boolean",
            "title": "Found",
            "default": true
          },
          "interrupted": {
            "type": "boolean",
            "title": "Interrupted",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "kind",
          "question",
          "answer",
          "lang"
        ],
        "title": "LocalMessageRequest",
        "example": {
          "answer": "Кафе справа от вас, метров 15.",
          "kind": "where_is",
          "lang": "ru",
          "place_id": "cafe",
          "question": "Где кафе?"
        }
      },
      "LocalMessageResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "LocalMessageResponse"
      },
      "PlaceOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "map_name": {
            "type": "string",
            "title": "Map Name"
          },
          "names": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Names"
          },
          "synonyms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Synonyms"
          },
          "description": {
            "additionalProperties": {
              "type": "string"
            },
