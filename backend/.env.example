# Скопируйте в backend/.env и заполните. Файл .env в git не попадает.

# Токен робота (тот же — в android-app/secrets.properties). Сгенерировать: openssl rand -hex 32
ROBOT_TOKEN=change-me-dev-token
# Второй профиль на том же сервере — робот Курултая (app/profiles.py, app/kurultai). Свой токен, отличный от
# ROBOT_TOKEN (тот же — в android-app/secrets.properties Курултая). Пусто — профиль kurultai выключен.
KURULTAI_ROBOT_TOKEN=
# Модель агента Курултая (пусто — AGENT_MODEL); веб-поиск OpenRouter только на новости, события и расписание
KURULTAI_AGENT_MODEL=
KURULTAI_WEB_SEARCH=true
# true — поиск на каждый вопрос; false — только новости, прошедшие события и расписание
KURULTAI_WEB_SEARCH_ALWAYS=true
KURULTAI_WEB_MAX_RESULTS=3
KURULTAI_WEB_TIMEOUT_S=10
# Снимок quryltai.kz в промпте Курултая: при старте и раз в час; без сети — последний (файл)
QURYLTAI_SYNC=true
QURYLTAI_REFRESH_S=3600
QURYLTAI_RETRY_S=300
RATE_LIMIT_PER_MIN=30
# Отдельный бакет для /places и /quick-questions
KB_RATE_LIMIT_PER_MIN=60
# /docs, /redoc, /openapi.json — только для локальной разработки
EXPOSE_DOCS=false

# Статистика задержек: GET /v1/admin/metrics и страница /v1/admin/metrics/page.
# Отдельный от ROBOT_TOKEN токен администратора (openssl rand -hex 32). Пусто — оба адреса отвечают 404.
ADMIN_TOKEN=
# ADMIN_RATE_LIMIT_PER_MIN=30

# ---------- Режим ответов ----------
# open   — сначала база знаний; если в ней нет ответа — модель отвечает из общих знаний (коротко,
#          без выдуманной конкретики о хабе), found=false, в логе category=general
# strict — только база знаний + small talk, иначе отказ «обратитесь на ресепшен»
ANSWER_MODE=open

# ---------- LLM ----------
# auto | gemini | openrouter | deepseek | fake. auto = gemini (GEMINI_API_KEY) → openrouter (OPENROUTER_API_KEY) → fake
LLM_PROVIDER=auto
# Vision для /look: auto | gemini | openrouter | fake
VISION_PROVIDER=auto

GEMINI_API_KEY=
# Основная модель. gemini-3.1-flash-lite — быстрее и с большим лимитом бесплатного ключа;
# gemini-3.5-flash — сильнее, но на бесплатном ключе часто 429/503.
GEMINI_MODEL=gemini-3.1-flash-lite
# Резервные модели через запятую: при 503/429/таймауте/обрыве — 1 повтор основной (если есть время),
# затем резервная; если основная молчит дольше GEMINI_HEDGE_AFTER_S — резервная стартует параллельно.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
# GEMINI_HEDGE_AFTER_S=3
# GEMINI_VISION_MODEL=           # по умолчанию = GEMINI_MODEL
# Размышления Gemini 3.x: minimal | low | medium | high (minimal — минимальная задержка)
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_THINKING_BUDGET=        # только для Gemini 2.5 (0 — выключить); используется, если THINKING_LEVEL пуст

DEEPSEEK_API_KEY=
# Потолок длины ответа модели (ответ ≤ 4 фраз / 600 символов + JSON). Включили размышления — поднимите.
# LLM_MAX_OUTPUT_TOKENS=320

DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Бюджет сервера на ответ LLM, сек, включая повтор и резервную модель (робот ждёт /ask 8 с, /look 12 с)
ASK_TIMEOUT_S=6.5
LOOK_TIMEOUT_S=11
# SSE /ask: весь стрим не дольше, сек
# ASK_STREAM_TOTAL_S=12

# ---------- База данных (PostgreSQL 16 + pgvector) ----------
# Единственная рабочая БД: база знаний, лог вопросов, сессии. Локально — из infra/:
#   cd infra && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres
# Пароль — POSTGRES_PASSWORD из infra/.env (только URL-safe символы). В compose api получает
# DATABASE_URL сам (…@postgres:5432/hub).
DATABASE_URL=postgresql+psycopg://hub:hub-local-dev-only@127.0.0.1:5432/hub
# Миграции Alembic при старте (до приёма запросов); ошибка миграции — сервер не стартует.
# false — только вручную: uv run python -m app.cli db upgrade
DB_AUTO_MIGRATE=true
# Таймаут подключения и запроса (connect_timeout, statement_timeout, lock_timeout), сек.
# Лог вопросов и сессии пишутся фоном, ответ роботу БД не ждёт.
# DB_TIMEOUT_S=2
# Хранение лога вопросов, сессий и сообщений, дней (0 — вечно); очистка раз в сутки фоном
QUESTION_LOG_RETENTION_DAYS=180
# QUESTION_LOG_QUEUE_MAX=1000

# ---------- База знаний ----------
# Живёт в Postgres. Источник для сотрудников — Google-таблица (синк в БД); YAML — сид для разработки.
# Пустая база и таблица не задана → при старте засеять из KNOWLEDGE_DIR (вручную: app.cli kb seed-yaml)
KB_SEED_YAML_IF_EMPTY=true
# KNOWLEDGE_DIR=./knowledge
# Как часто сервер сверяет версию базы в БД (kb_sync) и перечитывает её, сек
# KNOWLEDGE_RELOAD_INTERVAL_S=5
# Google-таблица (доступ «всем, у кого есть ссылка — читатель»). Если задан ID — фоновый синк таблица → БД.
# ID — часть ссылки между /d/ и /edit. Формат вкладок — README.md, шаблоны — knowledge/sheet_template/
KNOWLEDGE_SHEET_ID=
# KNOWLEDGE_SHEET_FACTS=Факты
# KNOWLEDGE_SHEET_PLACES=Места
# KNOWLEDGE_SHEET_BUTTONS=Кнопки
# KNOWLEDGE_SYNC_INTERVAL_S=300
# Все вкладки грузятся параллельно с общим таймаутом; старт сервера Google не ждёт
# KNOWLEDGE_SYNC_TIMEOUT_S=5
# Снимок последней загруженной из БД базы (старт, если Postgres недоступен).
# Локально по умолчанию backend/data/...; в Docker-образе — /data/knowledge_snapshot.json (volume)
# KNOWLEDGE_SNAPSHOT_PATH=./data/knowledge_snapshot.json

# ---------- Поиск по базе (RAG): справка к ходу (prefetch) или инструмент search_kb (tool) ----------
# Документы — knowledge/documents/<slug>.md (в БД — через kb seed-yaml), фрагменты и эмбеддинги сервер считает сам в фоне.
# Эмбеддинги: auto — openrouter при OPENROUTER_API_KEY, иначе off; fake — без сети (тесты); off — поиска нет
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=google/gemini-embedding-2      # 768 измерений = kb_chunks.embedding; сменили — всё переэмбеддится само
# EMBEDDING_QUERY_TIMEOUT_S=1.0                  # эмбеддинг вопроса; не успел — поиск только по словам
# EMBEDDING_BATCH_SIZE=64                        # текстов в одном запросе индексации
# EMBEDDING_TIMEOUT_S=30                         # один запрос индексации, сек
# prefetch — сервер сам ищет по реплике до ответа модели и кладёт найденное в сообщение хода («Справка»);
# tool — модель сама вызывает search_kb (hybrid — старое имя tool); off — без поиска, только факты в промпте
# RETRIEVAL_MODE=prefetch
# KB_PREFETCH_TIMEOUT_S=1.2                      # prefetch: потолок поиска на ход; не успел — к модели без справки

# ---------- Голос через сервер (/v1/stt, /v1/tts) ----------
# STT: auto | gemini | openrouter | elevenlabs | yandex | fake
#   auto: elevenlabs (есть ELEVENLABS_API_KEY) → gemini (есть GEMINI_API_KEY) → openrouter (есть OPENROUTER_API_KEY) → fake
# TTS: auto | elevenlabs | openrouter | yandex | fake
#   auto: elevenlabs → yandex → openrouter → fake. При fake ответ /tts с заголовком X-Speech-Provider: fake —
#   робот говорит встроенным синтезом.
STT_PROVIDER=auto
TTS_PROVIDER=auto

# Gemini STT
# GEMINI_STT_MODEL=gemini-3.1-flash-lite
# GEMINI_STT_FALLBACK_MODELS=gemini-3.5-flash

# OpenRouter: текст и vision (Gemini), STT (Gemini), TTS (модели ElevenLabs) — один ключ вместо ключей Gemini и ElevenLabs
OPENROUTER_API_KEY=
# Агентский чат /v1/chat (Haiku через OpenRouter): auto — включён при OPENROUTER_API_KEY; off — /chat отвечает как /ask
# CHAT_PROVIDER=auto
# AGENT_MODEL=anthropic/claude-haiku-5.5
# AGENT_TIMEOUT_S=6.5                 # до первой фразы, включая вызовы тулов
# AGENT_GREETING_TIMEOUT_S=1.8        # visitor_arrived: дольше — готовое приветствие
# AGENT_TOTAL_S=15
# AGENT_MAX_TURNS=4
# AGENT_HISTORY_MESSAGES=12
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite             # текст /ask (со стримингом) и vision /look
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash
# OPENROUTER_VISION_MODEL=                                   # по умолчанию = OPENROUTER_MODEL
# OPENROUTER_STT_MODEL=google/gemini-3.1-flash-lite
# OPENROUTER_STT_FALLBACK_MODELS=google/gemini-3.5-flash
# OPENROUTER_TTS_MODEL_KK=elevenlabs/eleven-v3              # казахский умеет только v3
# OPENROUTER_TTS_MODEL_DEFAULT=elevenlabs/eleven-flash-v2.5 # ru/en
# OPENROUTER_VOICE_RU=JBFqnCBsd6RMkjVDRZzb                  # voice_id ElevenLabs; по умолчанию «George»
# OPENROUTER_VOICE_KK=JBFqnCBsd6RMkjVDRZzb
# OPENROUTER_VOICE_EN=JBFqnCBsd6RMkjVDRZzb

# ElevenLabs (TTS + STT Scribe)
# Запасной TTS при ошибке основного (кончились кредиты, 5xx): робот не замолкает.
# Для мероприятия: TTS_PROVIDER=elevenlabs + TTS_FALLBACK_PROVIDER=openrouter (голоса — те же voice_id)
# TTS_FALLBACK_PROVIDER=
ELEVENLABS_API_KEY=
# ELEVENLABS_TTS_MODEL_KK=eleven_v3              # казахский умеет только v3 (flash для kk заменяется на v3)
# ELEVENLABS_TTS_MODEL_DEFAULT=eleven_flash_v2_5 # ru/en
# ELEVENLABS_TTS_MODEL_RU=                       # /v1/tts: своя модель для ru / en (пусто — DEFAULT)
# ELEVENLABS_TTS_MODEL_EN=
# Голоса — и /v1/tts, и live (WS /v1/live) берут одни и те же
ELEVENLABS_VOICE_RU=dVRDrbP5ULGXB94se4KZ         # Alina (eleven_flash_v2_5)
ELEVENLABS_VOICE_KK=Jbte7ht1CqapnZvc4KpK         # Kari (eleven_v3)
ELEVENLABS_VOICE_EN=FGY2WhTYpPnrIDTdsKH5         # Laura (eleven_flash_v2_5)
# voice_settings flash (ru и en, общие): энергичная подача
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.45
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.1                             # 0.7–1.2
# Eleven v3 (kk): только stability — 0.0 Creative / 0.5 Natural / 1.0 Robust
ELEVENLABS_V3_STABILITY=0.5
# Звуковой тег v3 перед каждой kk-фразой — только в запросе синтеза (не в субтитрах, истории, журнале);
# пусто — без тега
ELEVENLABS_V3_TAG=[cheerfully]
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# ELEVENLABS_STT_MODEL=scribe_v2
# Live STT (WebSocket /v1/stt/stream): auto — Scribe v2 Realtime при ELEVENLABS_API_KEY, иначе buffered
# (звук копится, по концу фразы — STT_PROVIDER). Ключ ElevenLabs при auto включает и прямой STT/TTS ElevenLabs —
# чтобы оставить их на OpenRouter, задайте STT_PROVIDER/TTS_PROVIDER явно.
# STT_STREAM_PROVIDER=auto                       # auto | elevenlabs | buffered
# ELEVENLABS_REALTIME_MODEL=scribe_v2_realtime
# ELEVENLABS_REALTIME_SILENCE_S=0.8              # пауза = конец фразы (0.5 режет между предложениями)
# STT_STREAM_NO_SPEECH_S=8

# Живой голосовой режим WS /v1/live (Pipecat). Пусто — включён при ELEVENLABS_API_KEY и OPENROUTER_API_KEY (агент);
# false — /v1/live сразу закрывается с error, робот работает в запасном режиме (/v1/chat + /v1/stt + /v1/tts).
# LIVE_ENABLED=
# LIVE_MAX_SESSIONS=2                            # одновременных live-сессий на токен робота
# LIVE_IDLE_TIMEOUT_S=120                        # ни речи, ни ответа, ни команд — закрыть сессию
# LIVE_STT_MODE=segmented                        # segmented: отрезки речи по VAD → STT_PROVIDER (тишина бесплатна,
#                                                без user_partial); elevenlabs: Scribe Realtime (платится всё время)
# LIVE_STT_SEGMENT_TIMEOUT_S=4.0                 # segmented: ждать текст отрезка не дольше, с
# LIVE_SMART_TURN=true                           # конец реплики — smart-turn v3 (локальная ONNX-модель)
# LIVE_TURN_MAX_SILENCE_S=0.8                    # smart-turn сказал «не договорил» — ждать тишину до
# LIVE_TURN_SILENCE_S=0.5                        # без smart-turn: тишина = конец реплики
# LIVE_VAD_START_S=0.2
# LIVE_VAD_STOP_S=0.2
# LIVE_VAD_CONFIDENCE=0.7
# LIVE_VAD_MIN_VOLUME=0.6
# LIVE_STT_FINAL_TIMEOUT_S=1.5
# LIVE_STT_LANGUAGE_HINT=false                   # false: автоопределение (язык не ru/kk/en — язык сессии);
#                                                true: язык экрана → STT
# LIVE_BARGE_IN=stop_only                        # v1.4 шумный зал: робота перебивает только команда «стоп»
#                                                («хватит», «тоқта», «stop»…), прочая речь во время ответа
#                                                отбрасывается; speech — прежнее: перебивает любая речь не шум
# LIVE_BARGE_IN_MIN_MS=300                       # speech: перебивание — речь не короче, мс (и текст не шум)
# LIVE_BARGE_IN_REQUIRE_TEXT=true                # speech
# LIVE_ECHO_RMS=1800                             # без AEC: тише — эхо ответа робота (RMS PCM16)
# LIVE_ECHO_MIN_MS=600                           # без AEC: перебивание от стольких мс речи
# LIVE_ECHO_TAIL_S=0.3
# LIVE_TTS_MODEL=eleven_flash_v2_5               # ru/en через WebSocket; kk — ELEVENLABS_TTS_MODEL_KK по HTTP
# LIVE_TTS_MODEL_RU=                             # своя модель live для языка (kk — только eleven_v3 / eleven_v4*)
# LIVE_TTS_MODEL_EN=
# LIVE_TTS_MODEL_KK=
# LIVE_FAST_PLACES=true                          # «где X?» / «проводите до X» / «да» на «Проводить вас?» —
#                                                шаблон + действие без модели; false — всё через агента
# LIVE_TTS_WARMUP=all                            # прогрев голосов при открытии сессии: all | active | off
# LIVE_TTS_WARMUP_INTERVAL_S=600                 # не чаще, на голос и модель (холодный голос — 10–19 с)
# LIVE_TTS_PHRASE_CACHE=true                     # звук шаблонных фраз — из кеша TTS (TTS_CACHE_DIR)
# LIVE_TTS_CHUNK_CHARS=120                       # длиннее — режется по запятым для синтеза (субтитр целый)
# LIVE_TTS_CHUNK_CHARS_KK=70                     # kk (v3) — мельче, первая фраза — особенно
# LIVE_TTS_FIRST_CHUNK_CHARS_KK=40

# Yandex SpeechKit (API v1): API-ключ сервисного аккаунта (роли ai.speechkit-stt.user, ai.speechkit-tts.user)
YANDEX_API_KEY=
# Нужен только для ключа/токена пользователя; для ключа сервисного аккаунта оставьте пустым
YANDEX_FOLDER_ID=
# Голоса API v1: ru — jane/filipp/ermil/omazh/zahar/marina/madi_ru; kk — amira/madi; en — john
# YANDEX_VOICE_RU=jane
# YANDEX_VOICE_KK=amira
# YANDEX_VOICE_EN=john

# Таймауты провайдера речи, сек (робот ждёт /stt 6 с, /tts 5 с)
STT_TIMEOUT_S=5
# В потоковом /v1/tts?stream=true — до первых байт
TTS_TIMEOUT_S=4
# Потоковый /v1/tts?stream=true (ElevenLabs): весь поток не дольше, сек
# TTS_STREAM_TOTAL_S=20
# Пиковая амплитуда ниже порога → тишина, пустой текст без вызова провайдера
# STT_SILENCE_PEAK=500
# Отдельный лимит для /stt и /tts (на один вопрос: 1 stt + N tts)
SPEECH_RATE_LIMIT_PER_MIN=120
# Кеш синтеза по (провайдер, голос/модель, язык, текст): память + папка на диске (пусто — только память)
TTS_CACHE_MEMORY_MB=32
# Локально по умолчанию backend/data/tts_cache; в Docker-образе — /data/tts_cache (volume)
# TTS_CACHE_DIR=./data/tts_cache
TTS_CACHE_DISK_MB=100

LOG_LEVEL=INFO
# Доверенные прокси (через запятую, сети или адреса): только от них берётся X-Forwarded-For для
# IP клиента в access-логе; в образе тот же список идёт в uvicorn --forwarded-allow-ips
# TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1

# ---------- Sentry ----------
# Пусто — выключено. Без ПДн: IP, тела запросов, тексты вопросов/ответов в Sentry не уходят.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
