# Скопируйте в infra/.env (вне git) и заполните. На сервере: chmod 600 infra/.env

# --- Compose ---
# Локально оставьте пустым (только api на SQLite). На сервере: prod,postgres
# (deploy.sh выставит это сам).
COMPOSE_PROFILES=
# Образ api. Пусто — собирается локально из ../backend. На сервере деплой из CI
# подставляет ghcr.io/<owner>/astana-hub-robot-api:<тег>.
API_IMAGE=
API_PORT=8000

# --- HTTPS (профиль prod) ---
DOMAIN=robot-api.example.kz
ACME_EMAIL=admin@example.kz

# --- Backend ---
# Сервер: Postgres из профиля postgres (драйвер psycopg; пароль = POSTGRES_PASSWORD ниже):
# DATABASE_URL=postgresql+psycopg://hub:<пароль>@postgres:5432/hub
# Локально без Postgres: SQLite в volume api-data.
DATABASE_URL=sqlite:////data/hub.db
# Токен робота (Authorization: Bearer ...). Тот же, что ROBOT_TOKEN в android-app/secrets.properties.
# Сгенерировать: openssl rand -hex 32
ROBOT_TOKEN=
# Ключи LLM и голоса — только здесь, никогда в APK и git.
# Полный список настроек и значения по умолчанию: backend/.env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
DEEPSEEK_API_KEY=
# open — Gemini отвечает и вне базы (без выдумывания фактов о хабе); strict — только база.
ANSWER_MODE=open
ASK_TIMEOUT_S=6.5
LOOK_TIMEOUT_S=11

# --- Голос ---
# auto: STT — elevenlabs → gemini → fake; TTS — elevenlabs → yandex → fake
# (fake = робот говорит встроенным голосом).
STT_PROVIDER=auto
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=

# --- База знаний ---
# ID Google-таблицы (между /d/ и /edit), доступ «по ссылке». Пусто — YAML из образа.
KNOWLEDGE_SHEET_ID=

SENTRY_DSN=
LOG_LEVEL=INFO

# --- Postgres (профиль postgres) ---
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=
