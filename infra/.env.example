# Скопируйте в infra/.env (вне git) и заполните. На сервере: chmod 600 infra/.env

# --- Compose ---
# Локально оставьте пустым (api + postgres). На сервере: prod (deploy.sh выставит сам).
# Postgres больше не профиль — поднимается всегда.
COMPOSE_PROFILES=
# Образ api. Пусто — собирается локально из ../backend. На сервере деплой из CI
# подставляет ghcr.io/<owner>/astana-hub-robot-api:<тег>.
API_IMAGE=
API_PORT=8000

# --- HTTPS (профиль prod) ---
DOMAIN=robot-api.example.kz
# Обязателен для профиля prod: без него caddy не стартует (уведомления Let's Encrypt).
# Пример: ACME_EMAIL=admin@astanahub.com
ACME_EMAIL=

# --- Backend ---
# Пусто — compose соберёт postgresql+psycopg://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/$POSTGRES_DB.
# Задавайте явно только для внешней БД.
DATABASE_URL=
# Миграции Alembic при старте api (true по умолчанию). false — вручную:
#   docker compose run --rm api python -m app.cli db upgrade
DB_AUTO_MIGRATE=true
# Токен робота (Authorization: Bearer ...). Тот же, что ROBOT_TOKEN в android-app/secrets.properties.
# Сгенерировать: openssl rand -hex 32
ROBOT_TOKEN=
# Робот Курултая на том же сервере (профиль kurultai): свой токен, отличный от ROBOT_TOKEN. Пусто — выключен.
# Тот же — в android-app/secrets.properties репозитория Курултая. Сгенерировать: openssl rand -hex 32
KURULTAI_ROBOT_TOKEN=
# Ключи LLM и голоса — только здесь, никогда в APK и git.
# Полный список настроек и значения по умолчанию: backend/.env.example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
DEEPSEEK_API_KEY=
# open — Gemini отвечает и вне базы (без выдумывания фактов о хабе); strict — только база.
ANSWER_MODE=open
ASK_TIMEOUT_S=6.5
LOOK_TIMEOUT_S=11

# OpenRouter: тот же Gemini для /ask, /look и /v1/stt без прямого ключа Gemini
# (LLM_PROVIDER/VISION_PROVIDER=openrouter); запасная озвучка — модели ElevenLabs через OpenRouter.
OPENROUTER_API_KEY=
LLM_PROVIDER=auto
VISION_PROVIDER=auto

# --- Голос ---
# auto: STT — elevenlabs → gemini → openrouter → fake; TTS — elevenlabs → yandex → openrouter → fake
# (fake = робот говорит встроенным голосом).
# Рекомендуемо для мероприятия: STT_PROVIDER=openrouter (казахский без подсказки языка — только Gemini),
# TTS_PROVIDER=elevenlabs, TTS_FALLBACK_PROVIDER=openrouter (кончились кредиты ElevenLabs — робот не замолкает).
STT_PROVIDER=auto
TTS_PROVIDER=auto
TTS_FALLBACK_PROVIDER=
# Ключ ElevenLabs (sk_…, не sk-or-…): озвучка и live-распознавание WS /v1/stt/stream (Scribe v2 Realtime).
ELEVENLABS_API_KEY=
# Женские голоса: RU Matilda, KZ Bella, EN Alice (voice_id ElevenLabs; для OpenRouter — те же)
ELEVENLABS_VOICE_RU=XrExE9yKIg1WjnnlVkGX
ELEVENLABS_VOICE_KK=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_VOICE_EN=Xb7hH8MSUJpSbSDYk0k2
OPENROUTER_VOICE_RU=XrExE9yKIg1WjnnlVkGX
OPENROUTER_VOICE_KK=hpp4J3VqNfWAUOO0d1Us
OPENROUTER_VOICE_EN=Xb7hH8MSUJpSbSDYk0k2
# Живой голосовой режим WS /v1/live (Pipecat): включается сам при ELEVENLABS_API_KEY + OPENROUTER_API_KEY.
# false — выключить (робот работает через /v1/chat + /v1/stt + /v1/tts). Остальные LIVE_* — backend/.env.example.
LIVE_ENABLED=
LIVE_MAX_SESSIONS=2
LIVE_IDLE_TIMEOUT_S=120

# --- База знаний ---
# ID Google-таблицы (между /d/ и /edit), доступ «по ссылке». Пусто — YAML из образа.
KNOWLEDGE_SHEET_ID=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Откуда доверять X-Forwarded-For (сеть docker, где стоит caddy).
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
LOG_LEVEL=INFO

# --- Postgres 16 + pgvector (обязателен) ---
POSTGRES_DB=hub
POSTGRES_USER=hub
# Обязателен, только URL-safe символы (подставляется в DATABASE_URL); без него postgres не стартует.
# Значение ниже — ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ (порт БД наружу не публикуется,
# docker-compose.dev.yml — только на 127.0.0.1). На сервере deploy.sh заменяет его на
# openssl rand -hex 24; вручную: sed -i "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(openssl rand -hex 24)/" .env
POSTGRES_PASSWORD=hub-local-dev-only
# Порт БД на ноутбуке (docker-compose.dev.yml, 127.0.0.1).
POSTGRES_PORT=5432
