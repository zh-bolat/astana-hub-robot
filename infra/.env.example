# Скопируйте в infra/.env (вне git) и заполните. На сервере: chmod 600 infra/.env

# --- Compose ---
# Локально оставьте пустым (только api). На сервере: prod (или prod,postgres).
COMPOSE_PROFILES=
# Образ api. Пусто — собирается локально из ../backend. На сервере деплой из CI
# подставляет ghcr.io/<owner>/astana-hub-robot-api:<тег>.
API_IMAGE=
API_PORT=8000

# --- HTTPS (профиль prod) ---
DOMAIN=robot-api.example.kz
ACME_EMAIL=admin@example.kz

# --- Backend ---
# MVP: SQLite в volume api-data. Для Postgres (профиль postgres):
# DATABASE_URL=postgresql+asyncpg://hub:<пароль>@postgres:5432/hub
DATABASE_URL=sqlite:////data/hub.db
# Токен робота (Authorization: Bearer ...). Тот же, что ROBOT_TOKEN в android-app/secrets.properties.
# Сгенерировать: openssl rand -hex 32
ROBOT_TOKEN=
# Ключи LLM — только здесь, никогда в APK и git.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Postgres (профиль postgres) ---
POSTGRES_DB=hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=
